{
  "expo": {
    "name": "Rento - Property & Rent Tracker",
    "slug": "rento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.landlord.rento",
      "infoPlist": {
        "NSCameraUsageDescription": "Rento requires camera access to scan your physical notebook rent records.",
        "NSPhotoLibraryUsageDescription": "Rento requires photo library access to upload ledger images."
      }
    },
    "android": {
      "package": "com.landlord.rento",
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rento requires camera access to scan your physical notebook rent records.",
          "photosPermission": "Rento requires photo library access to upload ledger images."
        }
      ],
      "expo-sharing"
    ]
  }
}
